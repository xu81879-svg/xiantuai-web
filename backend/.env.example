ENVIRONMENT=development
DEBUG=true
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=10080
DATABASE_URL=sqlite:///./xiantu.db
LOCAL_STORAGE_DIR=./data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
