ENVIRONMENT=development
DEBUG=true
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=10080
DATABASE_URL=sqlite:///./xiantu.db
PGSSLMODE=prefer
AUTO_CREATE_SCHEMA=true
SEED_DEMO_USER=true
DEMO_USER_EMAIL=demo@xiantu.ai
DEMO_USER_PASSWORD=请替换为本地演示密码
DEMO_USER_NAME=演示商家
LOCAL_STORAGE_DIR=./data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Railway 生产环境将 DATABASE_URL 设置为 ${{Postgres.DATABASE_URL}}
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MULTIMODAL_MODEL=qwen3-vl-plus
QWEN_IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_VISION_MODEL=qwen3-vl-plus
QWEN_IMAGE_MODEL=qwen-image-2.0-pro
QWEN_IMAGE_SIZE=1024*1024
QWEN_TIMEOUT_SECONDS=120
QWEN_READ_TIMEOUT_SECONDS=120
QWEN_MOCK_FALLBACK=true
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
PAYPAL_BRAND_NAME=鲜图 AI
PUBLIC_APP_URL=http://localhost:5173
PAYPAL_MOCK_MODE=true
PAYPAL_TIMEOUT_SECONDS=30
